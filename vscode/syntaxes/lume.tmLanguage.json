{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lume",
  "scopeName": "source.lume",
  "fileTypes": ["lm"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#fn-decl" },
    { "include": "#cl-decl" },
    { "include": "#type-decl" },
    { "include": "#spec-decl" },
    { "include": "#import" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtin-types" },
    { "include": "#adt-constructors" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#function-call" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lume",
          "match": "//.*$"
        },
        {
          "name": "comment.block.lume",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.lume" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.lume",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.lume" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.lume" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.lume",
          "match": "\\\\([nrt\"\\\\0]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
        },
        {
          "name": "meta.template.expression.lume",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.template-expression.begin.lume" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.template-expression.end.lume" }
          },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.lume",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.lume",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.lume",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.none.lume",
          "match": "\\b(none|None)\\b"
        }
      ]
    },
    "builtin-types": {
      "name": "support.type.primitive.lume",
      "match": "\\b(int|str|dec|bool|list|obj|Result|Option)\\b"
    },
    "adt-constructors": {
      "name": "support.type.adt.lume",
      "match": "\\b(Ok|Err|Some)\\b"
    },
    "types": {
      "name": "entity.name.type.lume",
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.lume",
          "match": "\\b(if|elsif|else|switch|case|default|for|in|match|try|catch|finally|return)\\b"
        },
        {
          "name": "keyword.declaration.lume",
          "match": "\\b(fn|let|cl|type|spec|pub|import|as|where)\\b"
        },
        {
          "name": "keyword.spec.lume",
          "match": "\\b(pre|pos|invariant|erro|Rule|Action|Erro)\\b"
        },
        {
          "name": "keyword.operator.logical.word.lume",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.control.loop.builtin.lume",
          "match": "\\b(getOutFor|nextFor)\\b"
        },
        {
          "name": "support.function.builtin.lume",
          "match": "\\b(print|assert|test|property|forall|old)\\b"
        }
      ]
    },
    "fn-decl": {
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.fn.lume" },
        "2": { "name": "entity.name.function.lume" }
      }
    },
    "cl-decl": {
      "match": "\\b(cl)\\s+([A-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.cl.lume" },
        "2": { "name": "entity.name.type.class.lume" }
      }
    },
    "type-decl": {
      "match": "\\b(type)\\s+([A-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.type.lume" },
        "2": { "name": "entity.name.type.alias.lume" }
      }
    },
    "spec-decl": {
      "match": "\\b(spec)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.spec.lume" },
        "2": { "name": "entity.name.function.spec.lume" }
      }
    },
    "import": {
      "match": "\\b(import)\\s+([a-zA-Z_][a-zA-Z0-9_.]*)",
      "captures": {
        "1": { "name": "keyword.control.import.lume" },
        "2": { "name": "entity.name.namespace.lume" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.lume",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.lume",
          "match": "->"
        },
        {
          "name": "keyword.operator.spread.lume",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.lume",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.lume",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.relational.lume",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.logical.lume",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.lume",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.lume",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.propagation.lume",
          "match": "\\?"
        }
      ]
    },
    "function-call": {
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.lume" }
      }
    },
    "identifier": {
      "name": "variable.other.lume",
      "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
    }
  }
}
