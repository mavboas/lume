{
  "main function": {
    "prefix": "main",
    "body": ["fn main()", "{", "\t$0", "}"],
    "description": "Main program entry point"
  },
  "function declaration": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2:params}) -> ${3:type}", "\"${4:description}\"", "{", "\t$0", "}"],
    "description": "Function with return type and doc string"
  },
  "public function": {
    "prefix": "pfn",
    "body": ["pub fn ${1:name}(${2:params}) -> ${3:type}", "\"${4:description}\"", "{", "\t$0", "}"],
    "description": "Public function"
  },
  "lambda": {
    "prefix": "lam",
    "body": ["(${1:x}) -> ${0:expr}"],
    "description": "Anonymous function"
  },
  "class declaration": {
    "prefix": "cl",
    "body": ["cl ${1:Name}", "{", "\t${2:field}: ${3:type}$0", "}"],
    "description": "Immutable product type"
  },
  "public class": {
    "prefix": "pcl",
    "body": ["pub cl ${1:Name}", "{", "\t${2:field}: ${3:type}$0", "}"],
    "description": "Public class"
  },
  "type alias": {
    "prefix": "type",
    "body": ["type ${1:Name} = ${0:str}"],
    "description": "Simple type alias"
  },
  "type ADT": {
    "prefix": "adt",
    "body": ["type ${1:Name} =", "\t| ${2:Variant1}", "\t| ${3:Variant2}($4)$0"],
    "description": "Algebraic data type"
  },
  "refinement type": {
    "prefix": "rtype",
    "body": ["type ${1:Name} = ${2:int} where ${0:> 0}"],
    "description": "Type alias with a refinement"
  },
  "if-elsif-else": {
    "prefix": "if",
    "body": ["if(${1:cond}){", "\t${2:body}", "}", "elsif(${3:cond}){", "\t${4:body}", "}", "else{", "\t$0", "}"],
    "description": "if / elsif / else"
  },
  "switch": {
    "prefix": "switch",
    "body": ["switch(${1:x}){", "\tcase(${2:value}){", "\t\t${3:body}", "\t}", "\tdefault(){", "\t\t$0", "\t}", "}"],
    "description": "switch / case / default"
  },
  "match": {
    "prefix": "match",
    "body": ["match(${1:x}){", "\tcase(${2:pattern}){ ${3:body} }", "\tcase(_){ $0 }", "}"],
    "description": "Pattern matching"
  },
  "for loop": {
    "prefix": "for",
    "body": ["for(${1:x} in ${2:items}){", "\t$0", "}"],
    "description": "Loop over an iterable value"
  },
  "for range": {
    "prefix": "range",
    "body": ["for(${1:i} in ${2:0}..${3:10}){", "\t$0", "}"],
    "description": "Loop over a numeric range"
  },
  "let block": {
    "prefix": "let",
    "body": ["let(${1:x} = ${2:value}){", "\t$0", "}"],
    "description": "Temporary scoped binding"
  },
  "spec - business rule": {
    "prefix": "spec",
    "body": ["spec ${1:name}(${2:args}){", "\tRule:   { ${3:cond} }", "\tAction: { ${4:action} }", "\tError:  { $0 }", "}"],
    "description": "Business-rule spec block"
  },
  "spec - formal contract": {
    "prefix": "fspec",
    "body": ["spec ${1:name}(${2:args}){", "\tpre: {", "\t\t${3:precondition}", "\t}", "\tpos: {", "\t\t${4:postcondition}", "\t}", "\tinvariant: {", "\t\t${5:invariant}", "\t}", "\terror: {", "\t\t$0", "\t}", "}"],
    "description": "Formal contract spec block"
  },
  "try-catch": {
    "prefix": "try",
    "body": ["try {", "\t${1:expr}", "}", "catch(${2:e}) {", "\t$0", "}"],
    "description": "Try / catch"
  },
  "try-catch-finally": {
    "prefix": "tryf",
    "body": ["try {", "\t${1:expr}", "}", "catch(${2:e}) {", "\t${3:handler}", "}", "finally {", "\t$0", "}"],
    "description": "Try / catch / finally"
  },
  "import": {
    "prefix": "imp",
    "body": ["import ${1:module}"],
    "description": "Import a module"
  },
  "import as": {
    "prefix": "impa",
    "body": ["import ${1:module} as ${2:alias}"],
    "description": "Import a module with an alias"
  },
  "import selective": {
    "prefix": "imps",
    "body": ["import ${1:module}.{${2:items}}"],
    "description": "Import selected symbols"
  },
  "Result Ok": {
    "prefix": "ok",
    "body": ["Ok(${0:value})"],
    "description": "Result Ok constructor"
  },
  "Result Err": {
    "prefix": "err",
    "body": ["Err(${0:reason})"],
    "description": "Result Err constructor"
  },
  "Option Some": {
    "prefix": "some",
    "body": ["Some(${0:value})"],
    "description": "Option Some constructor"
  },
  "test case": {
    "prefix": "test",
    "body": ["test \"${1:name}\"", "{", "\tassert($0)", "}"],
    "description": "Built-in test"
  },
  "property test": {
    "prefix": "prop",
    "body": ["property \"${1:name}\" forall(${2:a}: ${3:int}, ${4:b}: ${5:int})", "{", "\tassert($0)", "}"],
    "description": "Property-based test"
  },
  "http server": {
    "prefix": "http-server",
    "body": ["import http", "", "http.serve(port= ${1:8080}){", "\troute(\"GET\", \"${2:/health}\"){", "\t\thttp.ok({status: \"up\"})", "\t}", "\t$0", "}"],
    "description": "HTTP server skeleton"
  }
}
